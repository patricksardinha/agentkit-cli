{
  "name": "@patricksardinha/agentkit-cli",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Scaffolder des workflows multi-agents Claude Code",
  "type": "module",
  "bin": {
    "agentkit": "./dist/cli.js"
  },
  "main": "./dist/cli.cjs",
  "module": "./dist/cli.js",
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.20",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["cli", "agents", "claude", "scaffolding", "ai"],
  "license": "MIT"
}
